# AppFitness API — environment template (no real values here; copy to .env)

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 3001 by default so the legacy Express MVP (port 3000) can run alongside
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (live connection deferred until approved —
# schema validation/generation work with a placeholder value)
DATABASE_URL="postgresql://user:password@localhost:5432/appfitness_dev"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Access-token signing secret, min 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Refresh tokens are opaque random values stored hashed — no second secret needed.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Web CORS (ADR-P018 Slice 3) ──────────────────────────────────────────────
# Comma-separated EXACT browser origins allowed to call this API for interim
# Web Bearer auth. No wildcard, no path, no trailing slash. Unset/empty =
# fail-closed (no cross-origin browser access; native apps are unaffected).
# Configure per environment. Example for local Expo Web QA against the Dev API:
#   WEB_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
WEB_CORS_ORIGINS=

# ─── Monitoring (ADR-P010) ────────────────────────────────────────────────────
# Sentry is fully disabled when SENTRY_DSN is unset (local dev, CI, tests).
# All events pass privacy scrubbers (src/monitoring/sentry-scrub.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Medical field encryption (ADR-P006) ─────────────────────────────────────
# AES-256-GCM key for medical free-text at rest. Base64, exactly 32 bytes.
# Required in production (boot fails without it). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEDICAL_ENC_KEY=
MEDICAL_ENC_KEY_ID=k1
