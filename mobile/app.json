{
  "expo": {
    "name": "AppFitnessRD",
    "slug": "appfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/appfitnessrd-icon-v4.png",
    "scheme": "appfitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.appfitnessrd.mobile",
      "icon": "./assets/brand/appfitnessrd-icon-v4.png"
    },
    "android": {
      "package": "com.appfitnessrd.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#002C8F",
        "foregroundImage": "./assets/brand/appfitnessrd-adaptive-foreground-v3.png",
        "monochromeImage": "./assets/brand/appfitnessrd-adaptive-monochrome-v3.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/appfitnessrd-favicon-v4.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002C8F",
          "image": "./assets/brand/appfitnessrd-adaptive-foreground-v3.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edf05078-6821-4bcc-b501-1d737badd36a"
      }
    },
    "owner": "nelson1602"
  }
}
