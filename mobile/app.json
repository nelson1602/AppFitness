{
  "expo": {
    "name": "AppFitnessRD",
    "slug": "appfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/appfitnessrd-icon-v2.png",
    "scheme": "appfitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.appfitnessrd.mobile",
      "icon": "./assets/brand/appfitnessrd-icon-v2.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.appfitnessrd.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#002C8F",
        "foregroundImage": "./assets/brand/appfitnessrd-adaptive-foreground-v2.png",
        "monochromeImage": "./assets/brand/appfitnessrd-adaptive-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/appfitnessrd-favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002C8F",
          "image": "./assets/brand/appfitnessrd-mark-v1.png",
          "imageWidth": 168
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "AppFitnessRD uses Face ID so you can sign in without typing your password. Your face data never leaves your iPhone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AppFitnessRD uses Face ID so you can sign in without typing your password. Your face data never leaves your iPhone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edf05078-6821-4bcc-b501-1d737badd36a"
      }
    },
    "owner": "nelson1602",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    }
  }
}
