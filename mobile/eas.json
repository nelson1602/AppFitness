{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_HEALTH_CONNECT": "on"
      }
    },
    "internal": {
      "environment": "development",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://appfitness-production-1e78.up.railway.app",
        "EXPO_PUBLIC_HEALTH_CONNECT": "on"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "EXPO_PUBLIC_API_URL": "https://appfitness-production-5cfa.up.railway.app"
      }
    },
    "e2e": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "e2e",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3001",
        "EXPO_PUBLIC_APP_VARIANT": "e2e",
        "EXPO_PUBLIC_HEALTH_CONNECT": "on"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
