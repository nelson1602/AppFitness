# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment
.env
.env.local

# Store/submit credentials — NEVER commit (EAS submit reads these at submit time)
credentials/
*service-account*.json
*.keystore
*.jks

# Database
*.db
*.db-journal

# Prisma
server/prisma/migrations/

# Test & tooling caches (generated)
coverage/
.jest-cache/
node-compile-cache/

# Claude Code local (user-specific) settings — shared .claude/settings.json stays tracked
**/.claude/settings.local.json

# Claude–Codex bridge runtime state (per-worktree, never committed)
.ai/bridge/.runtime/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
