{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "scripts/ai-bridge.ps1",
              "-Mode",
              "StopHook"
            ],
            "timeout": 300,
            "statusMessage": "Codex is reviewing this result"
          }
        ]
      }
    ]
  }
}
